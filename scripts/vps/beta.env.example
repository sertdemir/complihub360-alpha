# ─── Beta-API: Umgebung (/docker/complihub-beta-api/.env, chmod 600) ─────────
# Vorlage ohne Werte. Werte NIE ins Repo. Was nicht gesetzt ist, faellt auf die
# Standardwerte im Code zurueck — die zeigen teils auf STAGING (z. B.
# PUBLIC_APP_URL). Darum hier jede Zeile bewusst setzen.
# Format wie die Staging-.env (docker-compose env_file, keine Anfuehrungszeichen).

NODE_ENV=production
PORT=3005
PUBLIC_APP_URL=https://beta.complihub360.com
ALLOWED_ORIGINS=https://beta.complihub360.com

# Supabase — das BETA-Projekt (docs/runbooks/beta-supabase.md), nie Staging
SUPABASE_URL=https://<beta-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Server-Schluessel fuer Admin-Aufrufe (Watcher-Tick, Abrechnungslauf) — NEU
# erzeugen (openssl rand -hex 32), nicht den von Staging uebernehmen.
API_KEY=
PROVIDER_INTAKE_TOKEN=

# Stripe — Testmodus (Beta = Testmodus, Beschluss Beta-Definition)
STRIPE_SECRET_KEY=sk_test_...
INVOICE_RETRY_ENABLED=false

# Mail (Resend) — verifizierte Absender-Domain
RESEND_API_KEY=
MAIL_FROM=CompliHub360 <beta@<verifizierte-domain>>
CONTACT_INBOX=

# Kalender (Nylas, EU) — Callback der BETA im Nylas-Dashboard eintragen
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
NYLAS_CALLBACK_URI=https://beta.complihub360.com/api/v1/nylas/callback
NYLAS_STATE_SECRET=

# Assistent (Embeddings fuer die Korpus-Suche)
GEMINI_API_KEY=

# Waechter (SLA-Erinnerung, Ablauf, Review-Frist): WATCHERS_ENABLED,
# WATCHERS_SHADOW, WATCHERS_TICK_MS, SLA_* , REVIEW_DEADLINE_HOURS — dieselben
# Werte wie in /docker/complihub-api/.env uebernehmen. Standard im Code ist
# enabled + shadow (rechnet, schreibt nur Marker, verschickt nichts).
# Der stuendliche Tick von aussen kommt aus watcher-tick.yml (Job „beta").
