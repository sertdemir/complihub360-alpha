{
  "extraKnownMarketplaces": {
    "complihub": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "complihub-loops@complihub": true
  },
  "permissions": {
    "allow": [
      "mcp__Supabase__list_organizations",
      "mcp__Supabase__get_organization",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_edge_functions",
      "mcp__Supabase__get_edge_function",
      "mcp__Supabase__list_branches",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__generate_typescript_types",
      "mcp__scaleway__account_project_get",
      "mcp__scaleway__account_project_list",
      "mcp__scaleway__account_project_list-resources",
      "mcp__scaleway__billing_budget_get",
      "mcp__scaleway__billing_budget_list",
      "mcp__scaleway__billing_charge_list",
      "mcp__scaleway__billing_consumption_list",
      "mcp__scaleway__billing_consumption_list-taxes",
      "mcp__scaleway__billing_discount_list",
      "mcp__scaleway__billing_invoice_get",
      "mcp__scaleway__billing_invoice_list",
      "mcp__scaleway__iam_api-key_get",
      "mcp__scaleway__iam_api-key_list",
      "mcp__scaleway__iam_application_get",
      "mcp__scaleway__iam_application_list",
      "mcp__scaleway__iam_group_get",
      "mcp__scaleway__iam_group_list",
      "mcp__scaleway__iam_jwt_get",
      "mcp__scaleway__iam_jwt_list",
      "mcp__scaleway__iam_log_get",
      "mcp__scaleway__iam_log_list",
      "mcp__scaleway__iam_organization_get-saml",
      "mcp__scaleway__iam_organization_get-scim",
      "mcp__scaleway__iam_permission-set_list",
      "mcp__scaleway__iam_policy_get",
      "mcp__scaleway__iam_policy_list",
      "mcp__scaleway__iam_rule_list",
      "mcp__scaleway__iam_saml-certificates_list",
      "mcp__scaleway__iam_scim-tokens_list",
      "mcp__scaleway__iam_security-settings_get",
      "mcp__scaleway__iam_ssh-key_get",
      "mcp__scaleway__iam_ssh-key_list",
      "mcp__scaleway__iam_user_get",
      "mcp__scaleway__iam_user_list",
      "mcp__scaleway__inference_deployment_get",
      "mcp__scaleway__inference_deployment_get-certificate",
      "mcp__scaleway__inference_deployment_list",
      "mcp__scaleway__inference_model_get",
      "mcp__scaleway__inference_model_list",
      "mcp__scaleway__inference_model_list-serverless",
      "mcp__scaleway__inference_node-type_list"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/config-protection.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy-raw-to-ai.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-typecheck.mjs\"",
            "timeout": 300,
            "statusMessage": "UI-Typecheck läuft …"
          }
        ]
      }
    ]
  }
}
