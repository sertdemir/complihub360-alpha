# ── compliance-api environment ───────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. The service refuses to boot without
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (see src/supabase.ts).

# Supabase project REST base, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Service-role key — FULL bypass of RLS. Server-side only, NEVER ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# JWT signing secret of the Supabase project (Dashboard → Settings → API → JWT Secret).
# REQUIRED for verifying user access tokens. Without it, the JWT auth path is dead
# and only the server API_KEY below can authenticate.
SUPABASE_JWT_SECRET=

# Shared secret for trusted server-to-server callers (sent as `x-api-key`).
API_KEY=

# Comma-separated allowed CORS origins for production (e.g. https://app.complihub360.com).
ALLOWED_ORIGINS=

# Port the HTTP server binds (the Vite dev proxy targets 3005 by default).
PORT=3005

# Set to "production" to enable strict CORS + opaque error messages.
NODE_ENV=development
# Assistent: Sprachmodell (llm.ts). Ziel seit 2026-10-18 ist Scaleway in Paris
# mit offenen Modellen. LLM_API_KEY = Scaleway Secret Key (IAM, Generative APIs).
# Ohne LLM_API_KEY faellt der Assistent auf GEMINI_API_KEY zurueck (Uebergang,
# entfaellt nach dem Cutover); ohne beide antwortet er 503.
LLM_API_KEY=
# LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_CHAT_MODEL=mistral-small-3.2-24b-instruct-2506
# LLM_EMBED_MODEL=qwen3-embedding-8b
GEMINI_API_KEY=
