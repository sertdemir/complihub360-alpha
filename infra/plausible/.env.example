# Vorlage für /docker/plausible/.env auf der VPS. NICHT ausgefüllt einchecken —
# SECRET_KEY_BASE ist ein Geheimnis.
#
#   cp .env.example .env
#   echo "SECRET_KEY_BASE=$(openssl rand -base64 48)" >> .env

# Host, unter dem Plausible läuft. Wird sowohl von Plausible (BASE_URL) als
# auch von den Traefik-Routern im compose.override.yml gelesen.
# Voraussetzung: A-Record auf 76.13.159.221, VOR dem ersten `up` angelegt
# (siehe docs/runbooks/preview-deploy.md — ein Host, der nach einem
# gescheiterten ACME-Order dazukommt, braucht einen Traefik-Neustart).
PLAUSIBLE_HOST=plausible.complihub360.com
BASE_URL=https://plausible.complihub360.com

# Mind. 64 Byte. Beim ersten Setup einmalig erzeugen und dann NIE ändern —
# ein neuer Key macht bestehende Sessions und den TOTP-Vault unbrauchbar.
SECRET_KEY_BASE=

# Interner Port, auf dem Plausible lauscht. Muss zum
# loadbalancer.server.port-Label im compose.override.yml passen.
HTTP_PORT=8000

# HTTPS_PORT bleibt ABSICHTLICH ungesetzt: sobald er gesetzt ist, versucht
# Plausible selbst ein Let's-Encrypt-Zertifikat zu holen. TLS macht hier
# ausschließlich Traefik.

# Kein offener Self-Service-Signup auf einer Staging-VPS.
DISABLE_REGISTRATION=invite_only
