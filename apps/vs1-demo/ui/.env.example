# ── Frontend (Vite) environment ──────────────────────────────────────────────
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars reach the browser.

# Base URL for the application API (compliance-api). Empty = use the Vite dev
# proxy (/api → compliance-api). Set an absolute URL for production builds.
VITE_API_URL=

# Dev-only proxy target override for `vite dev` (defaults to http://localhost:3005).
VITE_API_PROXY_TARGET=http://localhost:3005

# ── Real authentication (Supabase Auth) — required once login is wired ────────
# Public (browser-safe) Supabase project values. The ANON key is meant to be
# public; never put the SERVICE_ROLE key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Analytics (self-hosted Plausible CE, infra/plausible) ─────────────────────
# Both must be set or nothing loads — no script tag, no requests, no events.
# DOMAIN is the site name as registered inside Plausible, HOST its origin.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_HOST=https://plausible.complihub360.com
